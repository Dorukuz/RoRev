{
  "manifest_version": 3,
  "name": "RoRev – Game Earnings Estimates",
  "short_name": "RoRev",
  "version": "1.0.0",
  "description": "See estimated game earnings and public stats on Roblox experience pages. Free, open source, heuristic estimates only.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.roblox.com/*",
    "*://apis.roblox.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.roblox.com/games/*", "*://web.roblox.com/games/*"],
      "js": ["content/content.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "RoRev – Estimated earnings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
